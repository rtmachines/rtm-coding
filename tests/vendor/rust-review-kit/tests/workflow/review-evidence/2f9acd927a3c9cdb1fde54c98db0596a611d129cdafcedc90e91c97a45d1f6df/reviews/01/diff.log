+          "limitations": [
+            "Nie wykonano macierzy Rust 1.96/32-bit/Linux ani realnych usług zewnętrznych. Fragmenty domenowe są testowane z jawnymi stubami wyłącznie tam, gdzie brakuje kontekstu."
+          ]
+        }
+      ]
+    }
+  ],
+  "distribution": {
+    "prepared_date": "2026-10-24",
+    "repository": "https://github.com/rtmachines/rust-skills",
+    "branch": "master",
+    "evidence_note": "local-verification/... identifies historical logs retained locally; raw logs are not published. Use the checked-in regression scripts to reproduce applicable checks."
+  }
+}
